---
import { educationItems, funSections, siteMeta, workItems } from '../data/site.js';
import '../styles/record.css';

const music = funSections.find((section) => section.title === 'Music')?.items ?? [];
const experience = workItems.map((item) => ({
  organization: item.organization,
  period: item.displayRole ? item.period : item.roles[0].period,
  role: item.displayRole ?? item.roles[0].title,
}));
const linkedin = siteMeta.socialLinks.find((link) => link.label === 'LinkedIn')!;
const github = siteMeta.socialLinks.find((link) => link.label === 'GitHub')!;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#26080e" />
    <meta name="description" content="The highlights — education, work experience and music by Jingwen Wu" />
    <meta property="og:title" content="Jingwen Wu — The highlights" />
    <meta property="og:description" content="Education, work experience and music — flip the sleeve to explore" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.site} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/fonts/fraunces-retro.ttf" as="font" type="font/ttf" crossorigin />
    <link rel="preload" href="/fonts/dm-mono-regular.ttf" as="font" type="font/ttf" crossorigin />
    <link rel="preload" href="/fonts/shrikhand-regular.ttf" as="font" type="font/ttf" crossorigin />
    <title>Jingwen Wu — The highlights</title>
  </head>
  <body>
    <div class="record-page">
      <header class="page-header">
        <a class="wordmark" href="/" aria-label="Jingwen Wu, home">jw</a>
        <p class="edition">Personal recordings <span class="edition-divider">/</span> Vol. 01</p>
        <nav class="header-links" aria-label="Find me elsewhere">
          <a class="header-link" href={linkedin.href} target="_blank" rel="noopener noreferrer">LinkedIn <span aria-hidden="true">↗</span></a>
          <a class="header-link" href={github.href} target="_blank" rel="noopener noreferrer">GitHub <span aria-hidden="true">↗</span></a>
        </nav>
      </header>

      <main id="main-content">
        <nav class="sleeve-controls" aria-label="Album side">
          <button class="side-button" type="button" data-side="a" aria-controls="cover" aria-pressed="true">Side A</button>
          <button class="side-button" type="button" data-side="b" aria-controls="liner" aria-pressed="false">Side B</button>
        </nav>
        <p class="sr-only" id="side-status" aria-live="polite">Side A</p>
        <div class="record-stage">
          <div class="sleeve" id="sleeve">
            <div class="sleeve-inner">
              <section class="sleeve-face cover" id="cover" aria-label="Album cover">
                <div class="cover-topline micro"><span>JW—001</span><span>STEREO</span></div>
                <h1>Jingwen<br /><span>Wu</span></h1>
                <p class="cover-subtitle">The highlights</p>
                <div class="record-art" aria-hidden="true">
                  <img src="/images/vinyl-record.png" alt="" width="1920" height="1920" fetchpriority="high" />
                  <div class="record-label"><span class="label-name">Jingwen Wu</span><span class="label-hole"></span><span class="label-small">Side A · 33⅓ RPM</span></div>
                </div>
                <div class="cover-bottomline micro"><span>Side A / Vol. 01</span></div>
              </section>

              <section class="sleeve-face liner" id="liner" aria-label="About Jingwen and music" aria-hidden="true" inert>
                <div class="liner-topline micro"><span>JW—001 / About</span><span>Side B</span></div>
                <div class="liner-title"><h2>About</h2></div>
                <div class="liner-sections">
                  <section class="credits-section" aria-labelledby="education-heading">
                    <h3 id="education-heading" class="section-title micro"><span>01</span> Education</h3>
                    <ul class="credits-list">
                      {educationItems.map((item) => (
                        <li>
                          <h4>{item.school}</h4>
                          <p>{item.credential}</p>
                          <p class="credit-note">{item.notes[0]}</p>
                          {item.notes.some((note) => note.startsWith('Terman Award')) && <p class="credit-note">Terman Award</p>}
                          {item.notes.includes('Phi Beta Kappa') && <p class="credit-note">Phi Beta Kappa</p>}
                          <p class="credit-date">{item.period}</p>
                        </li>
                      ))}
                    </ul>
                  </section>
                  <section class="credits-section" aria-labelledby="work-heading">
                    <h3 id="work-heading" class="section-title micro"><span>02</span> Work experience</h3>
                    <ul class="credits-list">
                      {experience.map((item) => (
                        <li><h4>{item.organization}</h4><p>{item.role}</p><p class="credit-date">{item.period}</p></li>
                      ))}
                    </ul>
                  </section>
                  <section class="credits-section music-section" aria-labelledby="music-heading">
                    <h3 id="music-heading" class="section-title micro"><span>03</span> Music</h3>
                    <ol class="tracks" aria-label="Original music">
                      {music.map((track, index) => (
                        <li><a href={track.href} target="_blank" rel="noopener noreferrer"><span class="track-number">0{index + 1}</span><span class="track-name">{track.label}</span><span class="track-arrow" aria-hidden="true">↗</span></a></li>
                      ))}
                    </ol>
                    <span class="music-stamp" aria-hidden="true">33⅓<br /><span>ORIGINAL SOUND</span></span>
                  </section>
                </div>
                <div class="liner-footer"><span>Jingwen Wu / Side B</span></div>
              </section>
            </div>
          </div>
        </div>
        <noscript><p class="no-script">Explore my <a href="/education">education</a>, <a href="/work">work</a>, and <a href="/fun-stuff">music</a></p></noscript>
      </main>
      <footer class="page-footer">
        <p class="footer-copyright">© {new Date().getFullYear()} Jingwen Wu</p>
      </footer>
    </div>
    <script>
      const sleeve = document.querySelector<HTMLElement>('#sleeve');
      const cover = document.querySelector<HTMLElement>('#cover');
      const liner = document.querySelector<HTMLElement>('#liner');
      const sideButtons = [...document.querySelectorAll<HTMLButtonElement>('.side-button')];
      const sideStatus = document.querySelector<HTMLElement>('#side-status');

      if (sleeve && cover && liner && sideStatus && sideButtons.length === 2) {
        const setSide = (flipped: boolean) => {
          const hiddenFace = flipped ? cover : liner;
          const moveFocus = hiddenFace.contains(document.activeElement);

          sleeve.classList.toggle('is-flipped', flipped);
          cover.setAttribute('aria-hidden', String(flipped));
          cover.inert = flipped;
          liner.setAttribute('aria-hidden', String(!flipped));
          liner.inert = !flipped;

          sideButtons.forEach((button) => {
            button.setAttribute('aria-pressed', String(button.dataset.side === (flipped ? 'b' : 'a')));
          });
          sideStatus.textContent = flipped ? 'Side B' : 'Side A';

          if (moveFocus) {
            sideButtons.find((button) => button.dataset.side === (flipped ? 'b' : 'a'))?.focus({ preventScroll: true });
          }
        };

        sleeve.classList.add('is-interactive');
        sleeve.addEventListener('click', (event) => {
          const target = event.target;
          if (!(target instanceof Element) || target.closest('a, button, input, textarea, select, label, [contenteditable]')) return;
          if (window.getSelection()?.isCollapsed === false) return;
          setSide(!sleeve.classList.contains('is-flipped'));
        });

        sideButtons.forEach((button) => {
          button.addEventListener('click', () => setSide(button.dataset.side === 'b'));
        });
      }
    </script>
  </body>
</html>
